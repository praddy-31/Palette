{
  "name": "Palette",
  "$comment": "Palette: {{ theme }} (generated; edits are overwritten on the next switch)",
  "type": "{{ mode }}",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "{{ accent }}",
    "foreground": "{{ foreground }}",
    "descriptionForeground": "{{ dark_foreground }}",
    "errorForeground": "{{ red }}",
    "widget.border": "{{ muted }}",
    "selection.background": "{{ selection }}",
    "textLink.foreground": "{{ accent }}",
    "textLink.activeForeground": "{{ bright_blue }}",
    "button.background": "{{ accent }}",
    "button.foreground": "{{ background }}",
    "button.hoverBackground": "{{ bright_blue }}",
    "button.secondaryBackground": "{{ lighter_background }}",
    "button.secondaryForeground": "{{ foreground }}",
    "badge.background": "{{ accent }}",
    "badge.foreground": "{{ background }}",
    "activityBar.background": "{{ dark_background }}",
    "activityBar.foreground": "{{ foreground }}",
    "activityBar.inactiveForeground": "{{ muted }}",
    "activityBar.border": "{{ dark_background }}",
    "activityBar.activeBorder": "{{ accent }}",
    "activityBarBadge.background": "{{ accent }}",
    "activityBarBadge.foreground": "{{ background }}",
    "sideBar.background": "{{ dark_background }}",
    "sideBar.foreground": "{{ foreground }}",
    "sideBar.border": "{{ dark_background }}",
    "sideBarTitle.foreground": "{{ dark_foreground }}",
    "sideBarSectionHeader.background": "{{ dark_background }}",
    "sideBarSectionHeader.foreground": "{{ foreground }}",
    "list.activeSelectionBackground": "{{ selection }}",
    "list.activeSelectionForeground": "{{ bright_foreground }}",
    "list.inactiveSelectionBackground": "{{ lighter_background }}",
    "list.inactiveSelectionForeground": "{{ foreground }}",
    "list.hoverBackground": "{{ lighter_background }}",
    "list.focusOutline": "{{ accent }}",
    "list.highlightForeground": "{{ accent }}",
    "list.errorForeground": "{{ red }}",
    "list.warningForeground": "{{ yellow }}",
    "titleBar.activeBackground": "{{ dark_background }}",
    "titleBar.activeForeground": "{{ foreground }}",
    "titleBar.inactiveBackground": "{{ dark_background }}",
    "titleBar.inactiveForeground": "{{ muted }}",
    "titleBar.border": "{{ dark_background }}",
    "editor.background": "{{ background }}",
    "editor.foreground": "{{ foreground }}",
    "editorCursor.foreground": "{{ bright_foreground }}",
    "editor.selectionBackground": "{{ selection }}",
    "editor.inactiveSelectionBackground": "{{ lighter_background }}",
    "editor.lineHighlightBackground": "{{ lighter_background }}80",
    "editor.findMatchBackground": "{{ yellow }}66",
    "editor.findMatchHighlightBackground": "{{ yellow }}33",
    "editor.wordHighlightBackground": "{{ selection }}80",
    "editorLineNumber.foreground": "{{ muted }}",
    "editorLineNumber.activeForeground": "{{ accent }}",
    "editorIndentGuide.background1": "{{ lighter_background }}",
    "editorIndentGuide.activeBackground1": "{{ muted }}",
    "editorWhitespace.foreground": "{{ muted }}",
    "editorBracketMatch.border": "{{ orange }}",
    "editorBracketMatch.background": "{{ background }}",
    "editorError.foreground": "{{ red }}",
    "editorWarning.foreground": "{{ yellow }}",
    "editorInfo.foreground": "{{ blue }}",
    "editorHint.foreground": "{{ cyan }}",
    "editorGutter.addedBackground": "{{ green }}",
    "editorGutter.modifiedBackground": "{{ yellow }}",
    "editorGutter.deletedBackground": "{{ red }}",
    "editorWidget.background": "{{ dark_background }}",
    "editorWidget.border": "{{ muted }}",
    "editorSuggestWidget.background": "{{ dark_background }}",
    "editorSuggestWidget.selectedBackground": "{{ selection }}",
    "editorHoverWidget.background": "{{ dark_background }}",
    "editorGroup.border": "{{ dark_background }}",
    "editorGroupHeader.tabsBackground": "{{ dark_background }}",
    "tab.activeBackground": "{{ background }}",
    "tab.activeForeground": "{{ bright_foreground }}",
    "tab.activeBorderTop": "{{ accent }}",
    "tab.inactiveBackground": "{{ dark_background }}",
    "tab.inactiveForeground": "{{ dark_foreground }}",
    "tab.border": "{{ dark_background }}",
    "breadcrumb.foreground": "{{ dark_foreground }}",
    "breadcrumb.focusForeground": "{{ foreground }}",
    "panel.background": "{{ dark_background }}",
    "panel.border": "{{ lighter_background }}",
    "panelTitle.activeForeground": "{{ foreground }}",
    "panelTitle.inactiveForeground": "{{ muted }}",
    "panelTitle.activeBorder": "{{ accent }}",
    "statusBar.background": "{{ dark_background }}",
    "statusBar.foreground": "{{ foreground }}",
    "statusBar.border": "{{ dark_background }}",
    "statusBar.noFolderBackground": "{{ dark_background }}",
    "statusBar.debuggingBackground": "{{ orange }}",
    "statusBar.debuggingForeground": "{{ background }}",
    "statusBarItem.remoteBackground": "{{ accent }}",
    "statusBarItem.remoteForeground": "{{ background }}",
    "input.background": "{{ darker_background }}",
    "input.foreground": "{{ foreground }}",
    "input.border": "{{ lighter_background }}",
    "input.placeholderForeground": "{{ muted }}",
    "inputOption.activeBorder": "{{ accent }}",
    "dropdown.background": "{{ darker_background }}",
    "dropdown.foreground": "{{ foreground }}",
    "dropdown.border": "{{ lighter_background }}",
    "quickInput.background": "{{ dark_background }}",
    "quickInputList.focusBackground": "{{ selection }}",
    "scrollbarSlider.background": "{{ muted }}55",
    "scrollbarSlider.hoverBackground": "{{ muted }}88",
    "scrollbarSlider.activeBackground": "{{ muted }}bb",
    "progressBar.background": "{{ accent }}",
    "notifications.background": "{{ dark_background }}",
    "notifications.foreground": "{{ foreground }}",
    "gitDecoration.addedResourceForeground": "{{ green }}",
    "gitDecoration.modifiedResourceForeground": "{{ yellow }}",
    "gitDecoration.deletedResourceForeground": "{{ red }}",
    "gitDecoration.untrackedResourceForeground": "{{ cyan }}",
    "gitDecoration.ignoredResourceForeground": "{{ muted }}",
    "terminal.background": "{{ background }}",
    "terminal.foreground": "{{ foreground }}",
    "terminalCursor.foreground": "{{ bright_foreground }}",
    "terminal.selectionBackground": "{{ selection }}",
    "terminal.ansiBlack": "{{ ansi[0] }}",
    "terminal.ansiRed": "{{ ansi[1] }}",
    "terminal.ansiGreen": "{{ ansi[2] }}",
    "terminal.ansiYellow": "{{ ansi[3] }}",
    "terminal.ansiBlue": "{{ ansi[4] }}",
    "terminal.ansiMagenta": "{{ ansi[5] }}",
    "terminal.ansiCyan": "{{ ansi[6] }}",
    "terminal.ansiWhite": "{{ ansi[7] }}",
    "terminal.ansiBrightBlack": "{{ ansi[8] }}",
    "terminal.ansiBrightRed": "{{ ansi[9] }}",
    "terminal.ansiBrightGreen": "{{ ansi[10] }}",
    "terminal.ansiBrightYellow": "{{ ansi[11] }}",
    "terminal.ansiBrightBlue": "{{ ansi[12] }}",
    "terminal.ansiBrightMagenta": "{{ ansi[13] }}",
    "terminal.ansiBrightCyan": "{{ ansi[14] }}",
    "terminal.ansiBrightWhite": "{{ ansi[15] }}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{ dark_foreground }}", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw"], "settings": { "foreground": "{{ green }}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "{{ orange }}" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "{{ magenta }}" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "{{ cyan }}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "{{ blue }}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "{{ yellow }}" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "{{ foreground }}" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "{{ cyan }}" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "{{ light_foreground }}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{ red }}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "{{ yellow }}" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "{{ dark_foreground }}" } },
    { "scope": ["invalid"], "settings": { "foreground": "{{ red }}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{ accent }}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{ accent }}" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{ green }}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{ red }}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{ yellow }}" } }
  ]
}
