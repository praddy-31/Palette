# Generated by palette from theme "{{ theme }}". Edits are overwritten on the next switch.
# Palette writes these keys into its own GNOME Terminal profile ("Palette")
# with `dconf write`; open windows change at once.
use-theme-colors=false
background-color='{{ background }}'
foreground-color='{{ foreground }}'
bold-color-same-as-fg=true
cursor-colors-set=true
cursor-background-color='{{ bright_foreground }}'
cursor-foreground-color='{{ background }}'
highlight-colors-set=true
highlight-background-color='{{ selection }}'
highlight-foreground-color='{{ selection | ink(darker_background, bright_foreground) }}'
palette=[{% for colour in ansi %}'{{ colour }}'{% if not loop.last %}, {% endif %}{% endfor %}]
