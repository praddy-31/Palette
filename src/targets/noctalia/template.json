{%- macro on(bg) %}{{ bg | ink(darker_background, bright_foreground) }}{% endmacro -%}
{%- macro variant() -%}
{
    "mPrimary": "{{ accent }}",
    "mOnPrimary": "{{ on(accent) }}",
    "mSecondary": "{{ secondary }}",
    "mOnSecondary": "{{ on(secondary) }}",
    "mTertiary": "{{ tertiary }}",
    "mOnTertiary": "{{ on(tertiary) }}",
    "mError": "{{ red }}",
    "mOnError": "{{ on(red) }}",
    "mSurface": "{{ background }}",
    "mOnSurface": "{{ foreground }}",
    "mSurfaceVariant": "{{ lighter_background }}",
    "mOnSurfaceVariant": "{{ dark_foreground }}",
    "mOutline": "{{ muted }}",
    "mShadow": "{{ darker_background }}",
    "mHover": "{{ selection }}",
    "mOnHover": "{{ on(selection) }}",
    "terminal": {
      "background": "{{ background }}",
      "foreground": "{{ foreground }}",
      "cursor": "{{ bright_foreground }}",
      "cursorText": "{{ background }}",
      "selectionBg": "{{ selection }}",
      "selectionFg": "{{ on(selection) }}",
      "normal": {
        "black": "{{ ansi[0] }}", "red": "{{ ansi[1] }}", "green": "{{ ansi[2] }}", "yellow": "{{ ansi[3] }}",
        "blue": "{{ ansi[4] }}", "magenta": "{{ ansi[5] }}", "cyan": "{{ ansi[6] }}", "white": "{{ ansi[7] }}"
      },
      "bright": {
        "black": "{{ ansi[8] }}", "red": "{{ ansi[9] }}", "green": "{{ ansi[10] }}", "yellow": "{{ ansi[11] }}",
        "blue": "{{ ansi[12] }}", "magenta": "{{ ansi[13] }}", "cyan": "{{ ansi[14] }}", "white": "{{ ansi[15] }}"
      }
    }
  }
{%- endmacro -%}
{
  "_palette": "Generated by palette from theme {{ theme }} ({{ mode }}). Edits are overwritten on the next switch.",
  "dark": {{ variant() }},
  "light": {{ variant() }}
}
