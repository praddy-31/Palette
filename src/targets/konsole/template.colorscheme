{%- macro c(hex) %}{{ hex | rgb | replace(" ", "") }}{% endmacro -%}
# Generated by palette from theme "{{ theme }}". Edits are overwritten on the next switch.
# Palette copies this to ~/.local/share/konsole/Palette.colorscheme; its
# Palette profile uses it.

[Background]
Color={{ c(background) }}

[BackgroundFaint]
Color={{ c(background) }}

[BackgroundIntense]
Color={{ c(dark_background) }}
{% for colour in ansi %}
{%- if loop.index0 < 8 %}

[Color{{ loop.index0 }}]
Color={{ c(colour) }}

[Color{{ loop.index0 }}Faint]
Color={{ c(colour) }}
{%- else %}

[Color{{ loop.index0 - 8 }}Intense]
Color={{ c(colour) }}
{%- endif %}
{%- endfor %}

[Foreground]
Color={{ c(foreground) }}

[ForegroundFaint]
Color={{ c(dark_foreground) }}

[ForegroundIntense]
Color={{ c(bright_foreground) }}

[General]
Blur=false
ColorRandomization=false
Description=Palette
Opacity=1
