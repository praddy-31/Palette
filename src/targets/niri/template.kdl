// Generated by palette from theme "{{ theme }}". Edits are overwritten on the next switch.
// Loaded from ~/.config/niri/config.kdl by an include line Palette added at its end.
// Only colours: whether the focus ring and border are on, and their widths, stay yours.
layout {
    focus-ring {
        active-color "{{ accent }}"
        inactive-color "{{ muted }}"
        urgent-color "{{ red }}"
    }
    border {
        active-color "{{ accent }}"
        inactive-color "{{ muted }}"
        urgent-color "{{ red }}"
    }
    insert-hint {
        color "{{ accent }}80"
    }
}
