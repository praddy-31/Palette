{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Palette",
  "author": "Palette: {{ theme }} (generated; edits are overwritten on the next switch)",
  "themes": [
{%- for name, window in [("Palette", "opaque"), ("Palette Glass", "blurred"), ("Palette Clear", "transparent")] %}
    {
      "name": "{{ name }}",
      "appearance": "{{ mode }}",
      "style": {
{%- if window != "opaque" %}
        "background.appearance": "{{ window }}",
        "background": "{{ dark_background }}{{ zed_see }}",
        "surface.background": "#00000000",
        "elevated_surface.background": "{{ dark_background }}{{ zed_see_raised }}",
        "panel.background": "{{ dark_background }}{{ zed_see }}",
        "title_bar.background": "#00000000",
        "title_bar.inactive_background": "#00000000",
        "status_bar.background": "#00000000",
        "toolbar.background": "#00000000",
        "tab_bar.background": "#00000000",
        "tab.inactive_background": "#00000000",
        "tab.active_background": "{{ foreground }}14",
        "editor.background": "#00000000",
        "editor.gutter.background": "#00000000",
        "editor.active_line.background": "{{ foreground }}0d",
        "terminal.background": "#00000000",
        "border": "{{ foreground }}10",
{%- else %}
        "background.appearance": "opaque",
        "background": "{{ dark_background }}",
        "surface.background": "{{ dark_background }}",
        "elevated_surface.background": "{{ dark_background }}",
        "panel.background": "{{ dark_background }}",
        "title_bar.background": "{{ dark_background }}",
        "title_bar.inactive_background": "{{ dark_background }}",
        "status_bar.background": "{{ dark_background }}",
        "toolbar.background": "{{ background }}",
        "tab_bar.background": "{{ dark_background }}",
        "tab.inactive_background": "{{ dark_background }}",
        "tab.active_background": "{{ background }}",
        "editor.background": "{{ background }}",
        "editor.gutter.background": "{{ background }}",
        "editor.active_line.background": "{{ lighter_background }}80",
        "terminal.background": "{{ background }}",
        "border": "{{ lighter_background }}",
{%- endif %}
        "border.variant": "{{ lighter_background }}",
        "border.focused": "{{ accent }}",
        "border.selected": "{{ accent }}",
        "border.transparent": "#00000000",
        "border.disabled": "{{ lighter_background }}",
        "element.background": "{{ lighter_background }}",
        "element.hover": "{{ selection }}",
        "element.active": "{{ selection }}",
        "element.selected": "{{ selection }}",
        "element.disabled": "{{ lighter_background }}",
        "drop_target.background": "{{ accent }}33",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ lighter_background }}",
        "ghost_element.active": "{{ selection }}",
        "ghost_element.selected": "{{ selection }}",
        "ghost_element.disabled": "{{ lighter_background }}",
        "text": "{{ foreground }}",
        "text.muted": "{{ dark_foreground }}",
        "text.placeholder": "{{ muted }}",
        "text.disabled": "{{ muted }}",
        "text.accent": "{{ accent }}",
        "icon": "{{ foreground }}",
        "icon.muted": "{{ dark_foreground }}",
        "icon.disabled": "{{ muted }}",
        "icon.placeholder": "{{ dark_foreground }}",
        "icon.accent": "{{ accent }}",
        "search.match_background": "{{ yellow }}55",
        "panel.focused_border": "{{ accent }}",
        "scrollbar.thumb.background": "{{ muted }}55",
        "scrollbar.thumb.hover_background": "{{ muted }}99",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",
        "editor.foreground": "{{ foreground }}",
        "editor.subheader.background": "{{ dark_background }}",
        "editor.highlighted_line.background": "{{ lighter_background }}",
        "editor.line_number": "{{ muted }}",
        "editor.active_line_number": "{{ accent }}",
        "editor.invisible": "{{ muted }}",
        "editor.wrap_guide": "{{ lighter_background }}",
        "editor.active_wrap_guide": "{{ muted }}",
        "editor.document_highlight.read_background": "{{ selection }}80",
        "editor.document_highlight.write_background": "{{ selection }}aa",
        "terminal.foreground": "{{ foreground }}",
        "terminal.bright_foreground": "{{ bright_foreground }}",
        "terminal.dim_foreground": "{{ dark_foreground }}",
        "terminal.ansi.black": "{{ ansi[0] }}",
        "terminal.ansi.red": "{{ ansi[1] }}",
        "terminal.ansi.green": "{{ ansi[2] }}",
        "terminal.ansi.yellow": "{{ ansi[3] }}",
        "terminal.ansi.blue": "{{ ansi[4] }}",
        "terminal.ansi.magenta": "{{ ansi[5] }}",
        "terminal.ansi.cyan": "{{ ansi[6] }}",
        "terminal.ansi.white": "{{ ansi[7] }}",
        "terminal.ansi.bright_black": "{{ ansi[8] }}",
        "terminal.ansi.bright_red": "{{ ansi[9] }}",
        "terminal.ansi.bright_green": "{{ ansi[10] }}",
        "terminal.ansi.bright_yellow": "{{ ansi[11] }}",
        "terminal.ansi.bright_blue": "{{ ansi[12] }}",
        "terminal.ansi.bright_magenta": "{{ ansi[13] }}",
        "terminal.ansi.bright_cyan": "{{ ansi[14] }}",
        "terminal.ansi.bright_white": "{{ ansi[15] }}",
        "terminal.ansi.dim_black": "{{ ansi[0] }}aa",
        "terminal.ansi.dim_red": "{{ ansi[1] }}aa",
        "terminal.ansi.dim_green": "{{ ansi[2] }}aa",
        "terminal.ansi.dim_yellow": "{{ ansi[3] }}aa",
        "terminal.ansi.dim_blue": "{{ ansi[4] }}aa",
        "terminal.ansi.dim_magenta": "{{ ansi[5] }}aa",
        "terminal.ansi.dim_cyan": "{{ ansi[6] }}aa",
        "terminal.ansi.dim_white": "{{ ansi[7] }}aa",
        "link_text.hover": "{{ accent }}",
{%- for name, colour in [("error", red), ("warning", yellow), ("info", blue), ("hint", cyan), ("success", green), ("created", green), ("modified", yellow), ("deleted", red), ("renamed", blue), ("conflict", orange), ("ignored", muted), ("hidden", muted), ("unreachable", muted), ("predictive", muted)] %}
        "{{ name }}": "{{ colour }}",
        "{{ name }}.background": "{{ colour }}22",
        "{{ name }}.border": "{{ colour }}",
{%- endfor %}
        "version_control.added": "{{ green }}",
        "version_control.modified": "{{ yellow }}",
        "version_control.deleted": "{{ red }}",
        "players": [
{#- You (the first player) select in the editor's own selection (11h); collaborators keep a tint. #}
{%- for p in [accent, magenta, green, yellow, cyan, red, orange, blue] %}
          { "cursor": "{{ p }}", "background": "{{ p }}", "selection": "{{ editor_selection if loop.first else p ~ "3d" }}" }{{ "," if not loop.last }}
{%- endfor %}
        ],
        "syntax": {
{%- for name, colour, style, weight in [
  ("attribute", yellow, none, none),
  ("boolean", orange, none, none),
  ("comment", dark_foreground, "italic", none),
  ("comment.doc", dark_foreground, "italic", none),
  ("constant", orange, none, none),
  ("constructor", yellow, none, none),
  ("embedded", foreground, none, none),
  ("emphasis", accent, "italic", none),
  ("emphasis.strong", accent, none, 700),
  ("enum", yellow, none, none),
  ("function", blue, none, none),
  ("hint", cyan, none, none),
  ("keyword", magenta, none, none),
  ("label", accent, none, none),
  ("link_text", accent, none, none),
  ("link_uri", accent, "italic", none),
  ("number", orange, none, none),
  ("operator", cyan, none, none),
  ("predictive", muted, "italic", none),
  ("preproc", magenta, none, none),
  ("primary", foreground, none, none),
  ("property", cyan, none, none),
  ("punctuation", dark_foreground, none, none),
  ("punctuation.bracket", dark_foreground, none, none),
  ("punctuation.delimiter", dark_foreground, none, none),
  ("punctuation.list_marker", accent, none, none),
  ("punctuation.special", cyan, none, none),
  ("string", green, none, none),
  ("string.escape", orange, none, none),
  ("string.regex", orange, none, none),
  ("string.special", orange, none, none),
  ("string.special.symbol", orange, none, none),
  ("tag", red, none, none),
  ("text.literal", green, none, none),
  ("title", primary, none, 700),
  ("type", yellow, none, none),
  ("variable", foreground, none, none),
  ("variable.special", light_foreground, none, none),
  ("variant", yellow, none, none),
] %}
          "{{ name }}": { "color": "{{ colour }}", "font_style": {{ '"' ~ style ~ '"' if style else "null" }}, "font_weight": {{ weight if weight else "null" }} }{{ "," if not loop.last }}
{%- endfor %}
        }
      }
    }{{ "," if not loop.last }}
{%- endfor %}
  ]
}
