# Generated by Palette from theme "{{ theme }}". Edits are overwritten on the next switch.
# The same roles as Palette's Neovim colours. No background on text: the terminal's
# own (and its glass) shows through.
color-link default "{{ foreground }}"
color-link comment "{{ dark_foreground }}"
color-link identifier "{{ blue }}"
color-link constant "{{ orange }}"
color-link constant.string "{{ green }}"
color-link constant.string.char "{{ green }}"
color-link constant.number "{{ orange }}"
color-link constant.bool "{{ orange }}"
color-link statement "{{ magenta }}"
color-link symbol "{{ cyan }}"
color-link symbol.brackets "{{ dark_foreground }}"
color-link symbol.tag "{{ red }}"
color-link preproc "{{ cyan }}"
color-link type "{{ yellow }}"
color-link special "{{ cyan }}"
color-link underlined "underline {{ accent }}"
color-link error "bold {{ red }}"
color-link todo "bold {{ background }},{{ accent }}"
color-link hlsearch "{{ background }},{{ yellow }}"
color-link statusline "{{ foreground }},{{ lighter_background }}"
color-link tabbar "{{ foreground }},{{ lighter_background }}"
color-link indent-char "{{ muted }}"
color-link line-number "{{ muted }}"
color-link current-line-number "{{ accent }}"
color-link cursor-line "{{ lighter_background }}"
color-link color-column "{{ dark_background }}"
color-link divider "{{ muted }}"
color-link scrollbar "{{ muted }}"
color-link match-brace "{{ background }},{{ accent }}"
color-link diff-added "{{ green }}"
color-link diff-modified "{{ yellow }}"
color-link diff-deleted "{{ red }}"
color-link gutter-error "{{ red }}"
color-link gutter-warning "{{ yellow }}"
color-link tab-error "{{ red }}"
color-link trailingws "{{ red }}"
