{%- macro c(hex) %}{{ hex | rgb | replace(" ", "") }}{% endmacro -%}
{%- macro set(bg, alt, fg, inactive) -%}
BackgroundAlternate={{ c(alt) }}
BackgroundNormal={{ c(bg) }}
DecorationFocus={{ c(accent) }}
DecorationHover={{ c(accent) }}
ForegroundActive={{ c(accent) }}
ForegroundInactive={{ c(inactive) }}
ForegroundLink={{ c(blue) }}
ForegroundNegative={{ c(red) }}
ForegroundNeutral={{ c(orange) }}
ForegroundNormal={{ c(fg) }}
ForegroundPositive={{ c(green) }}
ForegroundVisited={{ c(magenta) }}
{%- endmacro -%}
# Generated by palette from theme "{{ theme }}" ({{ mode }}). Edits are overwritten on the next switch.
# Palette copies this into ~/.local/share/color-schemes/ as PaletteA or PaletteB
# (alternately: KDE ignores re-applying the scheme that is already active)
# and runs plasma-apply-colorscheme.

[Colors:Button]
{{ set(lighter_background, dark_background, foreground, dark_foreground) }}

[Colors:Complementary]
{{ set(darker_background, dark_background, foreground, dark_foreground) }}

[Colors:Header]
{{ set(dark_background, darker_background, foreground, dark_foreground) }}

[Colors:Header][Inactive]
{{ set(darker_background, darker_background, dark_foreground, muted) }}

[Colors:Selection]
{{ set(accent, selection, accent | ink(darker_background, bright_foreground), muted) }}

[Colors:Tooltip]
{{ set(lighter_background, dark_background, foreground, dark_foreground) }}

[Colors:View]
{{ set(background, dark_background, foreground, dark_foreground) }}

[Colors:Window]
{{ set(dark_background, background, foreground, dark_foreground) }}

[General]
ColorScheme=Palette
Name=Palette
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{ c(dark_background) }}
activeBlend={{ c(accent) }}
activeForeground={{ c(foreground) }}
inactiveBackground={{ c(darker_background) }}
inactiveBlend={{ c(muted) }}
inactiveForeground={{ c(muted) }}
