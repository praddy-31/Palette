<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A menu bar app, never in the Dock. macOS re-reads this whenever it hands a
       palette:// link to the running app (the SketchyBar pill, scroll to switch);
       without it, each link turned Palette into a Dock app. -->
  <key>LSUIElement</key>
  <true/>
  <!-- The bar's beat lines (ROADMAP 20): Palette's helper taps what the Mac plays. -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>Palette listens to what your Mac plays (never the microphone) to move the beat lines in your bar with the music. Nothing is recorded or stored.</string>
</dict>
</plist>
