{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palette",
  "version": "1.2.0",
  "identifier": "dev.palette.switcher",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": "sh app/sidecar.sh",
    "beforeDevCommand": "sh app/sidecar.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/palette-cli"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "palette"
        ]
      }
    }
  }
}
